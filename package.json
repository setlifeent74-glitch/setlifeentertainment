{
  "name": "setlifeentertainment",
  "private": true,
  "version": "0.0.0",
  "description": "Set Life Entertainment — CI harness (Phase 0). Static site today; Next.js from Phase 1.",
  "scripts": {
    "serve": "http-server . -p 4173 -s",
    "serve:ci": "http-server . -p 4173",
    "test:e2e": "playwright test",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "lhci:mobile": "lhci autorun --config=lighthouserc.mobile.json",
    "lhci:desktop": "lhci autorun --config=lighthouserc.desktop.json",
    "lhci": "npm run lhci:mobile && npm run lhci:desktop",
    "ci": "npm run test:e2e && npm run lhci"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.48.0",
    "http-server": "^14.1.1"
  }
}
