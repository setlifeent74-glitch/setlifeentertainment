# Copy to .env.local (gitignored) and fill in real values from the
# Supabase project dashboard: Settings → API.

# Safe to expose to the browser — RLS (supabase/migrations/*_rls_policies.sql)
# is what actually governs access, not secrecy of these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — bypasses RLS entirely. Used by the Stripe webhook handler
# (Phase 12) to write orders, and nowhere else. Never import this in a
# Client Component or anything that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
