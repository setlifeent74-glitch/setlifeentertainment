# Copy to .env.local (gitignored) and fill in real values from the
# Supabase project dashboard: Settings → API.

# Safe to expose to the browser — RLS (supabase/migrations/*_rls_policies.sql)
# is what actually governs access, not secrecy of these values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — bypasses RLS entirely. Used by the Stripe webhook handler
# (Phase 12) to write orders, and nowhere else. Never import this in a
# Client Component or anything that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — canonical origin for OG tags, sitemap, and JSON-LD. Falls back
# to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically on Vercel.
# Set explicitly for any non-Vercel host, or to pin a custom domain.
NEXT_PUBLIC_SITE_URL=https://setlifeentertainment.com

# Optional — Instagram Graph API token for §36 live Instagram feed. When
# absent the section falls back to CMS-curated editorial images.
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
